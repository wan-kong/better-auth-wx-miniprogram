{
  "name": "better-auth-wx-miniprogram",
  "version": "0.1.1",
  "description": "Better Auth plugin for WeChat Miniprogram login — silent sign-in via wx.login(), profile updates, and phone number decryption",
  "type": "module",
  "license": "MIT",
  "author": "wan-kong",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wan-kong/better-auth-wx-miniprogram"
  },
  "keywords": [
    "better-auth",
    "wechat",
    "miniprogram",
    "微信小程序",
    "auth",
    "login",
    "wx-miniprogram"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./wx-fetch-adapter": {
      "types": "./dist/wx-fetch-adapter.d.ts",
      "import": "./dist/wx-fetch-adapter.js",
      "require": "./dist/wx-fetch-adapter.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "bun run build",
    "bumpp": "bumpp",
    "test": "bun test",
    "format": "biome format . --write",
    "lint:fix": "biome check . --fix --unsafe",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "better-auth": ">=1.0.0"
  },
  "devDependencies": {
    "@better-fetch/fetch": "^1.1.21 ",
    "bumpp": "11.1.0",
    "@types/bun": "latest",
    "better-auth": "^1.0.0",
    "@biomejs/biome": "2.4.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}